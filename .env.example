# ─── Concept Crack — Environment Configuration ───────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit your `.env`.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API / server listens on
PORT=8787

# PostgreSQL connection string.
# Leave blank for local dev — the server falls back to
# postgresql://$USER@localhost:5432/prepmind
DATABASE_URL=

# Optional: Redis URL for sessions / rate-limiting / exam cache.
# Leave blank to use the built-in in-memory cache (fine for a single instance).
REDIS_URL=

# Comma-separated list of allowed browser origins for CORS (production only).
# Leave blank in development to allow all origins.
# Example: https://conceptcrack.app,https://www.conceptcrack.app
ALLOWED_ORIGINS=
