# Copy this file to .env.local and fill in the values for the Firebase project
# this checkout should talk to. .env.local is gitignored, so dev and test can
# point at different projects without any code change or merge conflict.
#
# Leave a line blank/absent to fall back to the concept-crack (production)
# default baked into src/lib/firebase.ts. So to run against production you need
# no .env.local at all; to run against a test project, fill in all of these.
#
# Values come from Firebase Console → Project settings → General → Your apps →
# Web app → the `firebaseConfig` object. Web API keys are NOT secret (access is
# gated by Firestore rules), so these are safe in .env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# The AI features (tutor + the QC answer-key verifier) read this. Reuse the same
# key you already have, or a new one from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ── Admin scripts (import / export / verify / deploy) do NOT use the vars above.
# They authenticate with scripts/service-account.json and read the project id
# straight out of that key file — so the project follows whichever key you drop
# in. Nothing to set here for them.
