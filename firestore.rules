rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Safely read the caller's role from Firestore (guards against missing doc)
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isAuthenticated() && userExists() && getUserRole() == role;
    }

    function isAdmin()   { return hasRole('admin');   }
    function isFaculty() { return hasRole('faculty'); }
    function isStudent() { return hasRole('student'); }
    function isParent()  { return hasRole('parent');  }

    function isAdminOrFaculty() { return isAdmin() || isFaculty(); }

    // ── /users/{uid} ───────────────────────────────────────────────────────────
    // Any signed-in user can read profiles (needed for messaging contacts,
    // battle invites, parent/faculty links, faculty verifier pickers and admin
    // management). Admins create/update any profile (admin-created accounts);
    // users own their own.
    match /users/{uid} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── /studentStats/{uid} ────────────────────────────────────────────────────
    // Students own their stats. Parents, faculty, and admins can read.
    match /studentStats/{uid} {
      allow read:  if isAuthenticated() && (isOwner(uid) || isAdminOrFaculty() || isParent());
      allow write: if isAuthenticated() && (isOwner(uid) || isAdmin());
    }

    // ── /studentActivity/{uid} ─────────────────────────────────────────────────
    // Website-activity / study-time tracking (Feature 4). The student writes their
    // own doc; parents, faculty and admins can read it.
    match /studentActivity/{uid} {
      allow read:  if isAuthenticated() && (isOwner(uid) || isAdminOrFaculty() || isParent());
      allow write: if isAuthenticated() && isOwner(uid);
    }

    // ── /institutes/{id} ──────────────────────────────────────────────────────
    // Any signed-in user can read. Only admins can write.
    match /institutes/{id} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── /questions/{id} ───────────────────────────────────────────────────────
    // Any signed-in user can read questions (needed for exams).
    // Faculty and admins can create/update. Admins delete any; faculty may delete
    // questions they uploaded themselves.
    match /questions/{id} {
      allow read:   if isAuthenticated();
      allow create: if isAdminOrFaculty();
      allow update: if isAdminOrFaculty();
      // Any faculty/admin can delete any question — matches the update rule
      // above. Bulk-imported questions (Career Point, ALLEN, etc.) have no
      // uploadedBy at all, so tying delete to ownership would leave faculty
      // unable to remove them.
      allow delete: if isAdminOrFaculty();
    }

    // ── /exams/{id} ───────────────────────────────────────────────────────────
    match /exams/{id} {
      allow read:  if isAuthenticated();
      allow write: if isAdminOrFaculty();
    }

    // ── /examAttempts/{id} ────────────────────────────────────────────────────
    // Students can create and update only their own attempt (while active).
    // Faculty and admins can read all attempts for reporting.
    match /examAttempts/{id} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdminOrFaculty()
      );
      allow create: if isStudent() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'active';
      allow delete: if isAdmin();
    }

    // ── /leaderboard/{uid} ────────────────────────────────────────────────────
    // Doc ID is the student's own uid. Any signed-in user can read the whole
    // board (needed to rank/display everyone); a student may only write their
    // own real, self-computed entry (see src/lib/leaderboard.ts) — never
    // another student's row.
    match /leaderboard/{uid} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated() && (isOwner(uid) || isAdmin());
    }

    // ── /notifications/{id} ───────────────────────────────────────────────────
    // Users read their own notifications. Any signed-in user may create a
    // notification for another user (approvals, messages, battle invites).
    // The recipient (or an admin) may update it — e.g. marking it read.
    match /notifications/{id} {
      allow read:   if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── /battles/{id} ─────────────────────────────────────────────────────────
    // 1-v-1 / group battle lobbies. Any signed-in student can read (to receive
    // invites) and write (join, submit their result, host configuration).
    match /battles/{id} {
      allow read:  if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── /chats/{id} and messages ──────────────────────────────────────────────
    // Real cross-user messaging. Only the two participants (or an admin) can read
    // or write the thread and its messages.
    match /chats/{id} {
      // resource is null the first time two people message each other (the doc
      // doesn't exist yet) — getOrCreateThread() always does a get() before the
      // create(), so this must short-circuit on resource == null before touching
      // resource.data, or Firestore denies the read outright instead of just
      // reporting "not found", and starting a first conversation silently fails.
      allow read:  if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());

      match /messages/{msgId} {
        allow read:   if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.participants;
        allow create: if isAuthenticated() &&
          request.resource.data.from == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.participants;
      }
    }

    // ── /contactMessages/{id} ─────────────────────────────────────────────────
    // Contact Us submissions. The Contact Us page is PUBLIC (reachable from the
    // login screen), so logged-out visitors may create — but only a well-formed
    // payload, to limit abuse. Only admins read/manage.
    match /contactMessages/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    // ── /auditLogs/{id} ───────────────────────────────────────────────────────
    // Admin-only visibility.
    match /auditLogs/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── /tests/{id} ───────────────────────────────────────────────────────────
    // Any signed-in user can read (students see assigned/coaching tests; the exam
    // reads test config). Faculty and admins create/update — this also covers the
    // approval workflow. Students may create their OWN self-service tests
    // (AI / custom / mock) so Custom Test, AI Test and Mock Test work.
    // Admins delete any; faculty may delete their own.
    match /tests/{id} {
      allow read:   if isAuthenticated();
      allow create: if isAdminOrFaculty() ||
        (isStudent() &&
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.type in ['ai', 'custom', 'mock']);
      allow update: if isAdminOrFaculty();
      allow delete: if isAdmin() || (isFaculty() && resource.data.createdBy == request.auth.uid);
    }

    // ── /testAttempts/{id} ────────────────────────────────────────────────────
    // Students create/read their own attempts; faculty and admins read all.
    match /testAttempts/{id} {
      allow read:   if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdminOrFaculty());
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── /chapters/{id} ────────────────────────────────────────────────────────
    match /chapters/{id} {
      allow read:  if isAuthenticated();
      allow write: if isAdminOrFaculty();
    }

    // ── /studentProgress/{uid} ─────────────────────────────────────────────────
    // Owner writes; owner, parents, faculty and admins can read.
    match /studentProgress/{uid} {
      allow read:  if isAuthenticated() && (isOwner(uid) || isAdminOrFaculty() || isParent());
      allow write: if isAuthenticated() && isOwner(uid);
    }

    // ── /studentWeakTopics/{uid} ───────────────────────────────────────────────
    match /studentWeakTopics/{uid} {
      allow read:  if isAuthenticated() && (isOwner(uid) || isAdminOrFaculty() || isParent());
      allow write: if isAuthenticated() && isOwner(uid);
    }

    // ── /companionSessions/{id} ────────────────────────────────────────────────
    // Stored AI Companion chat history. Students own their own sessions;
    // admins can read/manage any for support/moderation.
    match /companionSessions/{id} {
      allow read:   if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    // ── /questionFlags/{id} ───────────────────────────────────────────────────
    // Students report a question they think is wrong; only faculty/admins
    // manage the queue (resolve, or edit/delete the real question elsewhere).
    // Doc ID is deterministic (`${questionId}_${flaggedBy}`) so a student can
    // never report the same question twice — enforced here by requiring the
    // ID to match the content and the doc to not already exist.
    match /questionFlags/{id} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.flaggedBy == request.auth.uid
                    && id == (request.resource.data.questionId + '_' + request.auth.uid);
      allow update, delete: if isAdminOrFaculty();
    }

    // ── /questionHistory/{id} ─────────────────────────────────────────────────
    // Append-only audit trail of faculty/admin edits to bank questions (via
    // the Reported Questions review flow). Faculty need to read history for
    // questions they're reviewing, not just admins — no student access.
    match /questionHistory/{id} {
      allow read:   if isAuthenticated() && isAdminOrFaculty();
      allow create: if isAdminOrFaculty() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── /archivedQuestions/{id} ────────────────────────────────────────────────
    // Soft-deleted questions (Reported Questions "Delete" action archives the
    // original before removing it from the live bank). Faculty/admin only.
    match /archivedQuestions/{id} {
      allow read, create: if isAdminOrFaculty();
      allow update, delete: if isAdmin();
    }

    // ── /_meta/{id} ───────────────────────────────────────────────────────────
    // Seed tracking + the global question-code counter (Feature 3). Any
    // authenticated user can read/write.
    match /_meta/{id} {
      allow read, write: if isAuthenticated();
    }

  }
}
